{%- comment -%} One OpenRent product with its prices and booking. {%- endcomment -%}
{%- assign c = app.metafields.openrent.config.value -%}
{%- if c.api_url != blank and block.settings.product != blank -%}
  <openrent-product api="{{ c.api_url | escape }}" shop="{{ c.shop | escape }}" storefront="{{ c.storefront_url | escape }}" lang="{{ request.locale.iso_code | slice: 0, 2 | escape }}" product="{{ block.settings.product | handleize | escape }}" {{ block.shopify_attributes }}></openrent-product>
  <script src="{{ 'openrent-loader.js' | asset_url }}" defer></script>
{%- elsif request.design_mode -%}
  <p {{ block.shopify_attributes }}>{{ 'openrent.not_ready' | t }}</p>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product.name",
  "target": "section",
  "settings": [
    { "type": "text", "id": "product", "label": "t:blocks.product.product", "info": "t:blocks.product.product_info" }
  ]
}
{% endschema %}
