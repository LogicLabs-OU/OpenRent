{
  "name": "openrent",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @openrent/api test:integration",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @openrent/db migrate",
    "db:rollback": "pnpm --filter @openrent/db rollback",
    "db:seed": "pnpm --filter @openrent/db seed",
    "openapi": "pnpm --filter @openrent/api spec && pnpm --filter @openrent/sdk generate",
    "openrent": "pnpm --silent --filter @openrent/cli dev",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "db:pglite": "pnpm --filter @openrent/db pglite --max-connections 8",
    "db:generate": "pnpm --filter @openrent/db generate",
    "check:i18n": "node scripts/check-i18n.ts",
    "check:hardcoded": "node scripts/check-hardcoded.ts",
    "check:themes": "pnpm --silent --filter @openrent/cli dev theme check ../../packages/themes/default && pnpm --silent --filter @openrent/cli dev theme check ../../packages/themes/retro && pnpm --silent --filter @openrent/cli dev theme check ../../packages/themes/concept && pnpm --silent --filter @openrent/cli dev theme check ../../packages/themes/ink-green && pnpm --silent --filter @openrent/cli dev theme check ../../packages/themes/marquee && pnpm --silent --filter @openrent/cli dev theme check ../../packages/themes/linen && pnpm --silent --filter @openrent/cli dev theme check ../../packages/themes/nightfall",
    "test:scripts": "vitest run scripts",
    "test:accounting-live": "tsx scripts/accounting-live.ts",
    "test:calendar-live": "tsx scripts/calendar-live.ts",
    "test:imports-live": "tsx scripts/imports-live.ts",
    "test:messaging-live": "tsx scripts/messaging-live.ts",
    "test:payments-live": "tsx scripts/payments-live.ts",
    "storybook:a11y": "node scripts/storybook-a11y.ts",
    "check:api": "node scripts/check-api.ts",
    "test:signatures-live": "tsx scripts/signatures-live.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@openrent/geo-fakes": "workspace:*",
    "@openrent/messaging-fakes": "workspace:*",
    "@openrent/plugin-accounting-quickbooks": "workspace:*",
    "@openrent/plugin-accounting-xero": "workspace:*",
    "@openrent/plugin-accounting-zoho-books": "workspace:*",
    "@openrent/plugin-calendar-google": "workspace:*",
    "@openrent/plugin-calendar-microsoft": "workspace:*",
    "@openrent/plugin-notify-messagebird": "workspace:*",
    "@openrent/plugin-notify-twilio": "workspace:*",
    "@openrent/plugin-payment-mollie": "workspace:*",
    "@openrent/plugin-payment-paypal": "workspace:*",
    "@openrent/plugin-sdk": "workspace:*",
    "@openrent/plugin-sign-documenso": "workspace:*",
    "@openrent/plugin-sign-docusign": "workspace:*",
    "@openrent/rfid-fakes": "workspace:*",
    "@openrent/tax-fakes": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@wp-playground/cli": "^3.1.61",
    "eslint": "^10.13.0",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.20.0"
}
