{
  "name": "@openrent/admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 7071 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error && tsc -p src/service-worker/tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.61.0",
    "@openrent/i18n": "workspace:*",
    "@openrent/ui": "workspace:*",
    "@tiptap/core": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "barcode-detector": "^3.2.3",
    "bits-ui": "^2.20.2",
    "mode-watcher": "^1.1.0",
    "svelte-sonner": "^1.2.1",
    "zxing-wasm": "^3.1.6"
  }
}
