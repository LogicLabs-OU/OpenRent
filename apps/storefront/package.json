{
  "name": "@openrent/storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 7072 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "start": "node build/index.js",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.61.0",
    "@openrent/i18n": "workspace:*",
    "@openrent/plugin-sdk": "workspace:*",
    "@openrent/theme-concept": "workspace:*",
    "@openrent/theme-default": "workspace:*",
    "@openrent/theme-ink-green": "workspace:*",
    "@openrent/theme-linen": "workspace:*",
    "@openrent/theme-marquee": "workspace:*",
    "@openrent/theme-nightfall": "workspace:*",
    "@openrent/theme-retro": "workspace:*",
    "@openrent/theme-sdk": "workspace:*",
    "@openrent/ui": "workspace:*",
    "@stripe/stripe-js": "^10.1.0",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "qrcode": "^1.5.4",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  }
}
