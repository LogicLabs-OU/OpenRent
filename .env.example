# OpenRent configuration. Copy to .env and fill in. `scripts/gen-secrets.sh` writes the secrets for you.

# --- Database (PostgreSQL 16+, needs the btree_gist and pg_trgm extensions) -----------------
# Application role. Migrations create an RLS-bound role `openrent_app` when allowed to.
DATABASE_URL=postgres://openrent:openrent@localhost:5432/openrent
# Role allowed to run migrations (defaults to DATABASE_URL).
# DATABASE_MIGRATION_URL=
# DATABASE_POOL_MAX=10
# AUTO_MIGRATE=true
# Integration tests wipe this database; its name must contain "test".
# DATABASE_URL_TEST=postgres://openrent:openrent@localhost:5432/openrent_test

# --- Public URLs ----------------------------------------------------------------------------
OPENRENT_PUBLIC_URL=http://localhost:7070
# Where staff open the back office (dev server in development).
ADMIN_URL=http://localhost:7071/admin
# Hosted storefront (links in emails, order QR codes).
STOREFRONT_URL=http://localhost:7072
# Wildcard host for tenant storefronts in multi-tenant mode, e.g. rent.example.com
# OPENRENT_STOREFRONT_DOMAIN=
# Single-shop installs: which tenant the storefront serves (empty = the only tenant).
# TENANT_SLUG=demo
# Storefront → API (server side).
OPENRENT_API_URL=http://localhost:7070

# --- Secrets ----------------------------------------------------------------------------------
# Quickest: run ./scripts/gen-secrets.sh to fill both values below.
#
# 32 random bytes, base64. Encrypts provider credentials and webhook secrets at rest (AES-256-GCM).
# Generate with:  openssl rand -base64 32
#            or:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OPENRENT_ENCRYPTION_KEY=
# At least 32 characters. Signs cookies.
# Generate with:  openssl rand -hex 32
OPENRENT_SESSION_SECRET=
# The installation operator's key, sent as X-Operator-Key: protects /api/v1/system/metrics and turns on
# the operator API (/api/v1/operator/shops: limits, suspend, resume, erase). Generate with: openssl rand -hex 32
# OPENRENT_OPERATOR_KEY=
# Managed cloud (multi_tenant only): anyone may open a shop at /admin/signup.
# OPENRENT_SIGNUP=1
# Limits for shops opened by sign-up, JSON, e.g. {"orders_per_month":100,"storage_mb":1024,"plugins":5}
# OPENRENT_DEFAULT_LIMITS=
# Multi-shop installations refuse outbound requests to private networks (webhooks, plugins, imports).
# List your own internal services that plugins use, e.g. meilisearch:7700,search.internal
# OPENRENT_OUTBOUND_ALLOW=
# Which proxies may name the client address (X-Forwarded-For): by default loopback and private
# networks (Caddy, a load balancer); true trusts any, false none, or give addresses/CIDRs.
# TRUST_PROXY=

# --- Behaviour --------------------------------------------------------------------------------
OPENRENT_MODE=single_tenant
OPENRENT_LIVEMODE=false
LOG_LEVEL=info
PORT=7070
# Comma-separated origins allowed to call the API with credentials headers (storefront/widget calls work without it).
# CORS_ORIGINS=
# Document PDFs are rendered with headless Chromium. Install it once with:
#   pnpm exec playwright install chromium
# Set PDF_RENDERER=none to turn PDFs off (documents can still be printed from HTML).
# PDF_RENDERER=playwright
# WEBHOOKS_ALLOW_PRIVATE_NETWORK=false
# PLUGINS_CONFIG=./plugins.json
# Installed storefront themes (also compiled into the storefront build).
# THEMES_CONFIG=./themes.json
# Requests per minute per API key or staff session (default 600).
# RATE_LIMIT_PER_MINUTE=600
# PLUGINS_DIR=/plugins
# OPENRENT_DISABLED_PLUGINS=

# --- Stripe (test mode). Tenants can also set keys in Settings → Payments --------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the Stripe dashboard webhook, or `stripe listen --forward-to localhost:7070/webhooks/stripe/<tenant_id>`
STRIPE_WEBHOOK_SECRET=

# --- Email --------------------------------------------------------------------------------------
# Server default. Each shop can set its own SMTP server in Settings → Email, which takes priority.
# Without either, messages stay "queued" and are listed on each order.
# Local preview: docker compose -f deploy/compose/docker-compose.dev.yml up -d mailpit, then
#   SMTP_URL=smtp://localhost:1025 and open http://localhost:8025
# SMTP_URL=smtp://user:pass@localhost:1025
# EMAIL_FROM=Rentals <bookings@example.com>

# --- File storage -------------------------------------------------------------------------------
# Without S3 settings, uploads and PDFs are kept in PostgreSQL (fine for small shops and development).
# The Docker Compose install runs MinIO and fills these in; scripts/gen-secrets.sh sets MINIO_ROOT_PASSWORD.
# Move existing files to the store afterwards with: openrent files migrate-storage
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=openrent
# S3_ACCESS_KEY=openrent
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true
MINIO_ROOT_PASSWORD=

# --- Seeding ------------------------------------------------------------------------------------
# SEED_OWNER_EMAIL=owner@example.com
# SEED_OWNER_PASSWORD=openrent
